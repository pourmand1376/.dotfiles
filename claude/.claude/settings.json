{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/amirpourmand/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/amirpourmand/.claude/hooks/notify-macos.sh'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 310
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "daily-tools@smk": true,
    "learnable@smk": true,
    "open-design-guide@smk": true,
    "portal-skills@smk": true,
    "readable@smk": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "smk": {
      "source": {
        "source": "github",
        "repo": "smk-labs/claude-plugins"
      }
    }
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppuccin-latte",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(glab mr view:*)",
      "Bash(glab mr list:*)",
      "Bash(acli jira workitem view:*)",
      "Bash(kubectl -n insight-core get pods:*)",
      "Bash(kubectl -n jamshid-analytics get pods:*)"
    ]
  }
}
